# Cloudflare D1 (SQLite database for Better Auth + jobs)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_API_TOKEN=

# Cloudflare R2 (S3-compatible object storage for photos, frames, clips, final MP4)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=photo-to-video-assets

# Better Auth (runs inside Next.js, stores users/sessions in Cloudflare D1)
# Generate secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Optional: transactional email for Forgot Password (Resend free tier: 3,000/mo)
RESEND_API_KEY=
EMAIL_FROM=Photo to Video <onboarding@resend.dev>

# Inngest durable async job queue (breaks Vercel 300s timeout, adds retries + concurrency)
# Production: set INNGEST_EVENT_KEY and INNGEST_SIGNING_KEY (or connect via Vercel Marketplace).
# Local Dev:  set INNGEST_DEV=1 and run `npm run inngest:dev` in a second terminal.
# Unset:      automatically falls back to Next.js after() for zero-setup local dev.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# INNGEST_DEV=1
# INNGEST_JOB_CONCURRENCY=5

# LLM for per-image Nano Banana prompt generation (OpenAI-compatible)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-5.4

# Optional structural-consistency judge overrides (falls back to LLM_* if unset)
JUDGE_MODEL=
JUDGE_LLM_BASE_URL=
JUDGE_LLM_API_KEY=
JUDGE_THRESHOLD=70

# Image generation provider (swap these four vars to switch providers)
# IMAGE_API_FORMAT options:
#   openai-images  — POST /v1/images/generations, returns URL (novartspace.art default)
#   gemini-native  — POST /v1beta/models/…:generateContent, returns inline base64 (deprecated)
IMAGE_BASE_URL=
IMAGE_API_KEY=
IMAGE_MODEL=
IMAGE_API_FORMAT=openai-images

# Kling-compatible video API
# Use either KLING_API_KEY, or official-style KLING_ACCESS_KEY + KLING_SECRET_KEY.
KLING_PROVIDER=image2video
KLING_API_KEY=
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
KLING_API_BASE_URL=https://api-beijing.klingai.com
KLING_MODEL=kling-v3
KLING_MODE=pro
KLING_DURATION_SECONDS=3
KLING_RESOLUTION=1080p
KLING_SOUND=on
KLING_NATIVE_AUDIO=true
KLING_AUDIO_SYNC=true
KLING_POLL_ATTEMPTS=120
KLING_POLL_INTERVAL_MS=5000

# Kling Skill mode. Confirm these values in the Kling API Skill page.
KLING_SKILL_EFFECT_SCENE=
KLING_SKILL_CREATE_PATH=/v1/videos/effects
KLING_SKILL_STATUS_PATH=/v1/videos/{task_id}
# Optional JSON body template. Supported placeholders:
# {{effectScene}}, {{firstFrameUrl}}, {{lastFrameUrl}}, {{prompt}}, {{clipSeconds}}, {{aspectRatio}}
KLING_SKILL_REQUEST_TEMPLATE=

# Public base URL only needed for non-R2 local Kling Skill mode.
PUBLIC_ASSET_BASE_URL=
