    "tsx": "^4.19.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "stylelint": "^17.13.0",
    "stylelint-config-standard": "^40.0.0",
