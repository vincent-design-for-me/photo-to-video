{
  "name": "photo-to-video",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint:css": "stylelint \"app/**/*.module.css\" --allow-empty-input",
    "lint:css:legacy": "stylelint \"app/styles.css\"",
    "pretest": "npm run lint:css",
    "test": "node --import tsx --test test/*.test.ts",
    "kling:jwt": "node --env-file=.env.local --import tsx scripts/create-kling-jwt.ts",
    "judge:gallery": "node --env-file=.env.local --import tsx scripts/judge-gallery.ts",
    "db:generate": "npx drizzle-kit generate",
    "db:migrate": "node --env-file=.env.local ./node_modules/.bin/drizzle-kit migrate",
    "db:studio": "node --env-file=.env.local ./node_modules/.bin/drizzle-kit studio",
    "inngest:dev": "npx inngest-cli@latest dev -u http://localhost:3000/api/inngest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1175.0",
    "@aws-sdk/s3-request-presigner": "^3.1175.0",
    "@google/genai": "^1.3.0",
    "@hugeicons-pro/core-stroke-rounded": "^4.4.0",
    "@hugeicons/react": "^1.1.10",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "better-auth": "^1.7.27",
    "drizzle-orm": "^0.45.4",
    "ffmpeg-static": "^5.3.0",
    "inngest": "^4.27.0",
    "next": "^15.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.19.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "drizzle-kit": "^0.31.11",
    "stylelint": "^17.13.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-declaration-strict-value": "^1.11.1",
    "typescript": "^5.8.3",
    "wrangler": "^4.166.0"
  }
}
